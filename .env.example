# Copie este ficheiro para .env.local e preencha com as suas chaves reais.
# As chaves de teste (sk_test_...) encontram-se em: https://dashboard.stripe.com/test/apikeys

# Chave secreta da Stripe — nunca a exponha no cliente nem a partilhe.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Opcional: segredo do endpoint de webhook, usado para verificar assinaturas.
# Obtido ao criar o endpoint em https://dashboard.stripe.com/test/webhooks
# ou com `stripe listen --print-secret` durante testes locais.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# URL e chave pública (anon/publishable) do projeto Supabase — Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Opcional: só necessária para operações de servidor que precisem de ignorar
# RLS (ex.: um futuro painel de administração). NUNCA usar prefixo NEXT_PUBLIC_
# nisto nem importar em código "use client".
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# E-mail de confirmação de encomenda — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Precisa de um domínio verificado no Resend para produção.
RESEND_FROM_EMAIL=Kulanda <encomendas@kulanda-store.com>

# Opcional: recebe uma notificação por e-mail a cada encomenda paga.
# Por omissão usa o e-mail do dono da loja definido no código.
ADMIN_NOTIFICATION_EMAIL=dono@exemplo.com

# Opcional: ID de medição do Google Analytics 4 (gtag). Sem esta variável o
# GA simplesmente não carrega — não é preciso comentar nada no código.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Opcional: protege /api/cron/keep-alive para só aceitar pedidos do cron do
# Vercel. Defina a mesma variável nas Environment Variables do projeto na
# Vercel — o Vercel envia-a automaticamente como "Authorization: Bearer
# <valor>" quando invoca o cron (ver vercel.json). Gere um valor aleatório,
# ex.: `openssl rand -hex 32`.
CRON_SECRET=um-valor-aleatorio-e-secreto